{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopai",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopai-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "shopai-uploads"
    }
  ],
  "vars": {
    "CLOUDFLARE_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it"
  },
  "observability": {
    "enabled": true
  }
}
