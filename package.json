{
  "name": "shopai",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "preview": "vite preview",
    "test": "node --test",
    "lint": "tsc -b --pretty false",
    "deploy:cloudflare": "npm run build && npx wrangler@latest deploy",
    "cf:login": "npx wrangler@latest login",
    "cf:dev": "npm run build && npx wrangler@latest dev",
    "cf:db:create": "npx wrangler@latest d1 create shopai-db --binding DB",
    "cf:db:migrate": "npx wrangler@latest d1 migrations apply shopai-db --remote",
    "cf:r2:create": "npx wrangler@latest r2 bucket create shopai-uploads"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
